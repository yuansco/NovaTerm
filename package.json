{
  "name": "nova-term",
  "version": "1.0.1",
  "description": "Modern Ubuntu desktop terminal emulator with smart tabs, infinite split panes, built-in SSH, session persistence, and log streaming",
  "author": "yuansco <yuansco@users.noreply.github.com>",
  "homepage": "https://github.com/yuansco/NovaTerm",
  "desktopName": "novaterm.desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://localhost:5173 dist/main/main.js && electron . --no-sandbox\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron . --no-sandbox",
    "pack:dir": "npm run build && electron-builder --linux dir",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb",
    "pack:win": "npm run build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w node-pty",
    "test": "npm run build:main && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.novaterm.app",
    "productName": "NovaTerm",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.js",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty*/**"
    ],
    "linux": {
      "icon": "assets/icons",
      "category": "System;TerminalEmulator",
      "executableName": "novaterm",
      "syncDesktopName": true,
      "maintainer": "NovaTerm <novaterm@example.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
